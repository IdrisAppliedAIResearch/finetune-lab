      "max_steps": -1,
      "gate": {
        "enabled": true,
        "extra_epochs": 1.0,
        "min_rel_improvement": 0.005,
        "overfit_tolerance": 0.002,
        "max_generalisation_gap": 0.1,
        "lr_scale": 0.5
      },
      "resume_adapter": null
    },
    "metrics": {
